  CLOSED
  CANCELLED
}

model MaintenanceTicket {
  id       String            @id @default(uuid(7))
  tenantId String
  assetId  String
  title    String
  description String?
  status   MaintenanceStatus @default(OPEN)
  priority Int               @default(0)
  cost     Decimal?          @db.Decimal(14, 4)
  assignedTo String?
  isPreventive Boolean       @default(false)
  scheduledFor DateTime?
  resolvedAt DateTime?
  createdBy String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("maintenance_ticket")
}

// ─────────────────────────────────────────────── platform infrastructure ───

/// Transactional outbox: written in the same transaction as the aggregate,
/// relayed to RabbitMQ by the outbox publisher.
model OutboxEvent {
  id          String    @id @default(uuid(7))
  tenantId    String
  eventType   String    // e.g. "order.settled"
  payload     Json
  publishedAt DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([publishedAt, createdAt])
  @@map("outbox_event")
}

/// Consumer-side de-duplication for idempotent event handling.
model ProcessedEvent {
  id         String   @id // event id
  consumer   String
  processedAt DateTime @default(now())

  @@unique([id, consumer])
  @@map("processed_event")
}

/// HTTP idempotency for money/stock mutations.
model IdempotencyKey {
  id        String   @id @default(uuid(7))
  tenantId  String
  key       String
  endpoint  String
  requestHash String
  responseStatus Int?
  responseBody Json?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@unique([tenantId, key, endpoint])
  @@index([expiresAt])
  @@map("idempotency_key")
}

model WebhookEndpoint {
  id        String   @id @default(uuid(7))
  tenantId  String
  url       String
  secret    String
  eventTypes String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhook_endpoint")
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  DEAD
}

model WebhookDelivery {
  id         String                @id @default(uuid(7))
  tenantId   String
  endpointId String
  eventId    String
  eventType  String
  status     WebhookDeliveryStatus @default(PENDING)
  attempts   Int                   @default(0)
  lastAttemptAt DateTime?
  responseStatus Int?
  createdAt  DateTime              @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("webhook_delivery")
}

// ─────────────────────────────────────────────────────────────────── ai ────

model DemandForecast {
  id       String   @id @default(uuid(7))
  tenantId String
  outletId String
  menuItemId String?
  inventoryItemId String?
  date     DateTime @db.Date
  predictedQty Decimal @db.Decimal(14, 4)
  confidence Decimal? @db.Decimal(5, 4)
  modelVersion String?
  createdAt DateTime @default(now())

  @@unique([tenantId, outletId, menuItemId, inventoryItemId, date])
  @@index([tenantId, outletId, date])
  @@map("demand_forecast")
}

enum AnomalySeverity {
  INFO
  WARNING
  CRITICAL
}

enum AnomalyStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

model AnomalyAlert {
  id       String          @id @default(uuid(7))
  tenantId String
  kind     String          // void_spike / discount_abuse / stock_variance / …
  severity AnomalySeverity @default(WARNING)
  status   AnomalyStatus   @default(OPEN)
  locationId String?
  outletId String?
  subjectType String?      // user / item / vendor
  subjectId String?
  summary  String
  evidence Json            @default("{}")
  detectedAt DateTime      @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  @@index([tenantId, status, detectedAt])
  @@map("anomaly_alert")
}
