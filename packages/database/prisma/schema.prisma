// ═══════════════════════════════════════════════════════════════════════════
// Aureus — Hospitality ERP · Prisma schema
//
// Conventions (see docs/03-database-design.md):
//  • UUID v7 primary keys.
//  • Every tenant-owned model carries `tenantId` (indexed). Postgres RLS
//    policies over tenantId are added in migration SQL as defense-in-depth.
//  • Relations are modeled inside an aggregate (document → lines, hierarchy).
//    Cross-context references are plain indexed uuid columns; their FK
//    constraints are added in migration SQL so bounded contexts stay
//    decoupled at the code level but integral at the database level.
//  • Ledgers (stock, journal, wallet, loyalty, vendor) are append-only:
//    no updates, corrections are reversing rows.
//  • Documents are never deleted — they carry a status lifecycle.
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────── tenancy ───

model Tenant {
  id        String       @id @default(uuid(7))
  name      String
  slug      String       @unique
  status    TenantStatus @default(TRIAL)
  plan      String       @default("starter")
  trialEndsAt DateTime?
  country   String       @default("IN")
  currency  String       @default("INR")
  timezone  String       @default("Asia/Kolkata")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  companies Company[]
  users     User[]
  roles     Role[]
  modules   ModuleSubscription[]

  @@map("tenant")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CHURNED
}

model ModuleSubscription {
  id         String    @id @default(uuid(7))
  tenantId   String
  moduleCode String
  active     Boolean   @default(true)
  activatedAt DateTime @default(now())
  deactivatedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, moduleCode])
  @@map("module_subscription")
}

// ────────────────────────────────────────────────────────── organization ───

model Company {
  id            String  @id @default(uuid(7))
  tenantId      String
  name          String
  legalName     String
  code          String
  taxRegistrationNumber String? // GSTIN / VAT number
  panNumber     String?
  currency      String  @default("INR")
  country       String  @default("IN")
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  fiscalYearStartMonth Int @default(4) // April for India
  isActive      Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  brands    Brand[]
  locations Location[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("company")
}

model Brand {
  id        String  @id @default(uuid(7))
  tenantId  String
  companyId String
  name      String
  code      String
  logoUrl   String?
  cuisineType String?
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company   Company    @relation(fields: [companyId], references: [id])
  locations Location[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("brand")
}

enum LocationType {
  RESTAURANT
  HOTEL
  CLOUD_KITCHEN
  CAFE
  BAKERY
  BAR
  BREWERY
  FOOD_COURT_UNIT
  CATERING_UNIT
  WAREHOUSE
  COMMISSARY
  HEAD_OFFICE
}

model Location {
  id        String       @id @default(uuid(7))
  tenantId  String
  companyId String
  brandId   String?
  name      String
  code      String
  type      LocationType
  timezone  String       @default("Asia/Kolkata")
  addressLine1 String?
  addressLine2 String?
  city      String?
  state     String?
  postalCode String?
  latitude  Decimal?     @db.Decimal(9, 6)
  longitude Decimal?     @db.Decimal(9, 6)
  phone     String?
  email     String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  company  Company  @relation(fields: [companyId], references: [id])
  brand    Brand?   @relation(fields: [brandId], references: [id])
  outlets  Outlet[]
  stores   Store[]
  kitchenStations KitchenStation[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, companyId])
  @@map("location")
}

enum OutletType {
  DINE_IN
  QSR
  BAR
  BAKERY_COUNTER
  ROOM_SERVICE
  BANQUET
  DELIVERY_ONLY
  TAKEAWAY_COUNTER
}

model Outlet {
  id         String     @id @default(uuid(7))
  tenantId   String
  locationId String
  name       String
  code       String
  type       OutletType
  // operational day rolls at this local time, not midnight
  dayCloseTime String   @default("04:00")
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

  location  Location      @relation(fields: [locationId], references: [id])
  floors    Floor[]
  terminals PosTerminal[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, locationId])
  @@map("outlet")
}

model Floor {
  id       String @id @default(uuid(7))
  tenantId String
  outletId String
  name     String
  sortOrder Int   @default(0)

  outlet Outlet        @relation(fields: [outletId], references: [id])
  tables DiningTable[]

  @@index([tenantId])
  @@map("floor")
}

enum TableStatus {
  FREE
  SEATED
  BILLED
  BLOCKED
}

model DiningTable {
  id       String      @id @default(uuid(7))
  tenantId String
  floorId  String
  name     String
  capacity Int         @default(4)
  status   TableStatus @default(FREE)
  // floor-plan geometry
  posX     Int         @default(0)
  posY     Int         @default(0)
  shape    String      @default("square")
  qrToken  String?     @unique // QR self-ordering deep link
  isActive Boolean     @default(true)

  floor Floor @relation(fields: [floorId], references: [id])

  @@index([tenantId])
  @@index([tenantId, floorId])
  @@map("dining_table")
}

enum TerminalStatus {
  PENDING_ACTIVATION
  ACTIVE
  DISABLED
}

model PosTerminal {
  id             String         @id @default(uuid(7))
  tenantId       String
  outletId       String
  name           String
  code           String
  status         TerminalStatus @default(PENDING_ACTIVATION)
  deviceFingerprint String?
  activationCode String?
  activatedAt    DateTime?
  lastSeenAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  outlet Outlet @relation(fields: [outletId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId, outletId])
  @@map("pos_terminal")
}

enum StoreType {
  MAIN
  KITCHEN
  BAR
  HOUSEKEEPING
  WAREHOUSE
  COMMISSARY
}

model Store {
  id         String    @id @default(uuid(7))
  tenantId   String
  locationId String
  name       String
  code       String
  type       StoreType
  allowNegativeStock Boolean @default(false)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  location Location @relation(fields: [locationId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId, locationId])
  @@map("store")
}

model KitchenStation {
  id         String  @id @default(uuid(7))
  tenantId   String
  locationId String
  name       String
  code       String
  // printer routing for KOTs
  printerAddress String?
  isActive   Boolean @default(true)

  location Location @relation(fields: [locationId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId, locationId])
  @@map("kitchen_station")
}

/// Per-document-type numbering. POS terminals pre-allocate blocks so they
/// can issue fiscal invoice numbers offline without collision.
model DocumentSequence {
  id         String @id @default(uuid(7))
  tenantId   String
  companyId  String
  docType    String // e.g. POS_INVOICE, PURCHASE_ORDER, GRN, JOURNAL
  fiscalYear String // e.g. "2026-27"
  prefix     String @default("")
  nextNumber BigInt @default(1)
  padding    Int    @default(6)

  @@unique([tenantId, companyId, docType, fiscalYear])
  @@map("document_sequence")
}

model TerminalSequenceBlock {
  id         String  @id @default(uuid(7))
  tenantId   String
  terminalId String
  docType    String
  fiscalYear String
  blockStart BigInt
  blockEnd   BigInt
  consumed   BigInt  @default(0)
  createdAt  DateTime @default(now())

  @@index([tenantId, terminalId])
  @@map("terminal_sequence_block")
}

// ─────────────────────────────────────────────────────────────── identity ───

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(uuid(7))
  tenantId     String
  email        String
  phone        String?
  firstName    String
  lastName     String?
  passwordHash String?
  posPinHash   String?    // 4–6 digit PIN for terminal login
  status       UserStatus @default(INVITED)
  isTenantOwner Boolean   @default(false)
  twoFactorSecret String?
  twoFactorEnabled Boolean @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  assignments UserRoleAssignment[]
  sessions    RefreshSession[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("user")
}

model Role {
  id          String  @id @default(uuid(7))
  tenantId    String
  code        String
  name        String
  description String?
  isSystem    Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("role")
}

model RolePermission {
  id         String @id @default(uuid(7))
  tenantId   String
  roleId     String
  /// grant pattern from the shared catalog: exact, `pos.*`, `res:*`, or `*`
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([tenantId])
  @@map("role_permission")
}

enum RoleScopeType {
  TENANT
  COMPANY
  LOCATION
}

model UserRoleAssignment {
  id        String        @id @default(uuid(7))
  tenantId  String
  userId    String
  roleId    String
  scopeType RoleScopeType @default(TENANT)
  companyId String?
  locationId String?
  createdAt DateTime      @default(now())
  createdBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeType, companyId, locationId])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("user_role_assignment")
}

model RefreshSession {
  id         String   @id @default(uuid(7))
  tenantId   String
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  terminalId String?  // set for POS terminal sessions
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("refresh_session")
}

/// Append-only. Written by a Prisma extension on every mutation.
model AuditLog {
  id         String   @id @default(uuid(7))
  tenantId   String
  actorId    String?  // user id; null for system jobs
  actorType  String   @default("USER") // USER | SYSTEM | INTEGRATION
  action     String   // e.g. "pos.order:void"
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  terminalId String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────── catalog ───

model Category {
  id        String  @id @default(uuid(7))
  tenantId  String
  name      String
  code      String
  parentId  String?
  sortOrder Int     @default(0)
  imageUrl  String?
  isActive  Boolean @default(true)
  deletedAt DateTime?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  items    MenuItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("category")
}

enum DietaryType {
  VEG
  NON_VEG
  EGG
  VEGAN
}

model MenuItem {
  id          String      @id @default(uuid(7))
  tenantId    String
  categoryId  String
  name        String
  code        String
  description String?
  imageUrl    String?
  dietaryType DietaryType @default(VEG)
  allergens   String[]    @default([])
  /// direct-stock items (e.g. bottled drink) map straight to an inventory item
  inventoryItemId String?
  /// recipe-costed items map to a Recipe (production context)
  recipeId    String?
  taxGroupId  String?
  kitchenStationId String?
  isSellable  Boolean     @default(true)
  isAvailable Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  category       Category                @relation(fields: [categoryId], references: [id])
  variants       MenuItemVariant[]
  modifierGroups MenuItemModifierGroup[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@map("menu_item")
}

model MenuItemVariant {
  id         String  @id @default(uuid(7))
  tenantId   String
  menuItemId String
  name       String  // Regular / Large / 30ml / Bottle
  sku        String?
  basePrice  Decimal @db.Decimal(14, 4)
  isDefault  Boolean @default(false)
  isActive   Boolean @default(true)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([tenantId, menuItemId])
  @@map("menu_item_variant")
}

model ModifierGroup {
  id        String  @id @default(uuid(7))
  tenantId  String
  name      String
  minSelect Int     @default(0)
  maxSelect Int     @default(1)
  isActive  Boolean @default(true)
  deletedAt DateTime?

  modifiers Modifier[]
  items     MenuItemModifierGroup[]

  @@index([tenantId])
  @@map("modifier_group")
}

model Modifier {
  id              String  @id @default(uuid(7))
  tenantId        String
  modifierGroupId String
  name            String
  price           Decimal @default(0) @db.Decimal(14, 4)
  inventoryItemId String? // optional stock impact
  consumptionQty  Decimal? @db.Decimal(14, 4)
  isActive        Boolean @default(true)

  group ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("modifier")
}

model MenuItemModifierGroup {
  id              String @id @default(uuid(7))
  tenantId        String
  menuItemId      String
  modifierGroupId String
  sortOrder       Int    @default(0)

  menuItem MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  group    ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, modifierGroupId])
  @@index([tenantId])
  @@map("menu_item_modifier_group")
}

enum PriceListKind {
  OUTLET
  CHANNEL
  HAPPY_HOUR
  DAY_PART
}

model PriceList {
  id        String        @id @default(uuid(7))
  tenantId  String
  name      String
  kind      PriceListKind
  outletId  String?
  channel   OrderChannel?
  /// higher wins when several lists match
  priority  Int           @default(0)
  daysOfWeek Int[]        @default([]) // 0=Sun … 6=Sat; empty = all
  startTime String?       // "17:00" local, for happy hour / day-part
  endTime   String?
  validFrom DateTime?
  validTo   DateTime?
  isActive  Boolean       @default(true)
  deletedAt DateTime?

  items PriceListItem[]

  @@index([tenantId])
  @@index([tenantId, outletId])
  @@map("price_list")
}

model PriceListItem {
  id                String  @id @default(uuid(7))
  tenantId          String
  priceListId       String
  menuItemVariantId String
  price             Decimal @db.Decimal(14, 4)

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([priceListId, menuItemVariantId])
  @@index([tenantId])
  @@map("price_list_item")
}

// ────────────────────────────────────────────────────────────── inventory ───

model Uom {
  id        String  @id @default(uuid(7))
  tenantId  String
  name      String  // Kilogram
  code      String  // KG
  precision Int     @default(3)

  @@unique([tenantId, code])
  @@map("uom")
}

model UomConversion {
  id        String  @id @default(uuid(7))
  tenantId  String
  itemId    String  // inventory item scoped conversion (1 crate = 24 bottles)
  fromUomId String
  toUomId   String
  factor    Decimal @db.Decimal(14, 6)

  @@unique([itemId, fromUomId, toUomId])
  @@index([tenantId])
  @@map("uom_conversion")
}

enum InventoryItemType {
  RAW_MATERIAL
  SEMI_FINISHED
  FINISHED_GOOD
  PACKAGING
  LIQUOR
  BEVERAGE
  HOTEL_SUPPLY
  CLEANING_SUPPLY
  STATIONERY
  ASSET_ITEM
}

enum ValuationMethod {
  WEIGHTED_AVERAGE
  FIFO
  LIFO
}

model InventoryItem {
  id          String            @id @default(uuid(7))
  tenantId    String
  name        String
  code        String
  type        InventoryItemType
  categoryName String?
  baseUomId   String
  purchaseUomId String?
  barcode     String?
  hsnCode     String?           // tax classification
  taxGroupId  String?
  isPerishable Boolean          @default(false)
  shelfLifeDays Int?
  trackBatches Boolean          @default(false)
  /// bar module: bottle volume in ml and standard peg size
  bottleVolumeMl Decimal?       @db.Decimal(10, 2)
  pegSizeMl   Decimal?          @db.Decimal(10, 2)
  standardCost Decimal          @default(0) @db.Decimal(14, 4)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  reorderLevels ReorderLevel[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, type])
  @@map("inventory_item")
}

model ReorderLevel {
  id        String  @id @default(uuid(7))
  tenantId  String
  itemId    String
  storeId   String
  minQty    Decimal @db.Decimal(14, 4)
  parQty    Decimal @db.Decimal(14, 4)

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, storeId])
  @@index([tenantId, storeId])
  @@map("reorder_level")
}

/// O(1) on-hand per store × item, maintained transactionally with every
/// stock_ledger insert. avgCost is the running weighted average.
model StockSummary {
  id       String  @id @default(uuid(7))
  tenantId String
  storeId  String
  itemId   String
  onHand   Decimal @default(0) @db.Decimal(14, 4)
  avgCost  Decimal @default(0) @db.Decimal(14, 4)
  updatedAt DateTime @updatedAt

  @@unique([storeId, itemId])
  @@index([tenantId, storeId])
  @@index([tenantId, itemId])
  @@map("stock_summary")
}

model StockBatch {
  id         String    @id @default(uuid(7))
  tenantId   String
  itemId     String
  storeId    String
  batchNumber String
  expiryDate DateTime?
  receivedAt DateTime  @default(now())
  unitCost   Decimal   @db.Decimal(14, 4)
  qtyReceived Decimal  @db.Decimal(14, 4)
  qtyRemaining Decimal @db.Decimal(14, 4)

  @@index([tenantId, storeId, itemId])
  @@index([tenantId, expiryDate])
  @@map("stock_batch")
}

enum StockMovementType {
  OPENING
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  PRODUCTION_CONSUME
  PRODUCTION_OUTPUT
  SALE_CONSUMPTION
  SALE_RETURN
  ADJUSTMENT
  WASTE
  PILFERAGE
  COUNT_VARIANCE
}

/// Append-only single source of stock truth.
model StockLedger {
  id           String            @id @default(uuid(7))
  tenantId     String
  storeId      String
  itemId       String
  batchId      String?
  movementType StockMovementType
  /// signed: receipts +, issues −
  qty          Decimal           @db.Decimal(14, 4)
  unitCost     Decimal           @db.Decimal(14, 4)
  /// document that caused the movement
  sourceType   String
  sourceId     String
  sourceLineId String?
  businessDate DateTime          @db.Date
  note         String?
  createdBy    String?
  createdAt    DateTime          @default(now())

  @@index([tenantId, storeId, itemId, createdAt])
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, businessDate])
  @@map("stock_ledger")
}

enum TransferStatus {
  DRAFT
  DISPATCHED
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id          String         @id @default(uuid(7))
  tenantId    String
  number      String
  fromStoreId String
  toStoreId   String
  status      TransferStatus @default(DRAFT)
  dispatchedAt DateTime?
  receivedAt  DateTime?
  note        String?
  createdBy   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lines StockTransferLine[]

  @@unique([tenantId, number])
  @@index([tenantId, fromStoreId])
  @@index([tenantId, toStoreId])
  @@map("stock_transfer")
}

model StockTransferLine {
  id         String  @id @default(uuid(7))
  tenantId   String
  transferId String
  itemId     String
  batchId    String?
  qty        Decimal @db.Decimal(14, 4)
  qtyReceived Decimal? @db.Decimal(14, 4)
  unitCost   Decimal @db.Decimal(14, 4)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("stock_transfer_line")
}

enum AdjustmentReason {
  WASTE
  PILFERAGE
  DAMAGE
  EXPIRY
  SPILLAGE
  CORRECTION
  OTHER
}

model StockAdjustment {
  id       String           @id @default(uuid(7))
  tenantId String
  number   String
  storeId  String
  reason   AdjustmentReason
  note     String?
  businessDate DateTime     @db.Date
  createdBy String?
  createdAt DateTime        @default(now())

  lines StockAdjustmentLine[]

  @@unique([tenantId, number])
  @@index([tenantId, storeId])
  @@map("stock_adjustment")
}

model StockAdjustmentLine {
  id           String  @id @default(uuid(7))
  tenantId     String
  adjustmentId String
  itemId       String
  batchId      String?
  /// signed quantity change
  qty          Decimal @db.Decimal(14, 4)
  unitCost     Decimal @db.Decimal(14, 4)

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("stock_adjustment_line")
}

enum CountStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  POSTED
  CANCELLED
}

model StockCount {
  id       String      @id @default(uuid(7))
  tenantId String
  number   String
  storeId  String
  status   CountStatus @default(DRAFT)
  countedAt DateTime?
  postedAt DateTime?
  createdBy String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  lines StockCountLine[]

  @@unique([tenantId, number])
  @@index([tenantId, storeId])
  @@map("stock_count")
}

model StockCountLine {
