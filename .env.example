# Copy to apps/api/.env for local development
DATABASE_URL="postgresql://aureus:aureus_dev@localhost:5432/aureus?schema=public"
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://aureus:aureus_dev@localhost:5672"

# Auth — generate real secrets for anything beyond local dev:  openssl rand -base64 48
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me"
JWT_ACCESS_TTL="600s"
JWT_REFRESH_TTL="30d"

API_PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Storage (optional in local dev — falls back to disk)
S3_BUCKET=""
S3_REGION="ap-south-1"

# Observability (optional)
SENTRY_DSN=""
